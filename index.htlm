```html
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Murmullos | Menú de Bebidas</title>

    <link rel="stylesheet" href="estilo.css">

    <!-- Fuente elegante -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,500;1,600&family=Montserrat:wght@400;500;600&display=swap" rel="stylesheet">
</head>

<body>

    <!-- ENCABEZADO -->
    <header class="encabezado">

        <div class="luna">☾</div>

        <h1>Murmullos</h1>

        <p class="subtitulo">MENÚ DE BEBIDAS</p>

        <div class="linea"></div>

    </header>


    <!-- CONTENIDO -->
    <main class="menu">

        <section class="categoria">

            <h2>Coctelería</h2>

            <!-- MEZCALITAS -->
            <article class="bebida">

                <div class="informacion">

                    <div class="nombre-precio">
                        <h3>Mezcalitas</h3>
                        <span>Consultar</span>
                    </div>

                    <p>
                        Mezcal y cítricos con un toque refrescante.
                    </p>

                </div>

                <button class="boton-foto"
                        onclick="abrirFoto('mezcalitas')"
                        aria-label="Ver foto de Mezcalitas">
                    📷
                </button>

            </article>


            <!-- GIN DE FRUTOS ROJOS -->
            <article class="bebida">

                <div class="informacion">

                    <div class="nombre-precio">
                        <h3>Gin de frutos rojos</h3>
                        <span>Consultar</span>
                    </div>

                    <p>
                        Gin acompañado de frutos rojos y notas frescas.
                    </p>

                </div>

                <button class="boton-foto"
                        onclick="abrirFoto('gin-frutos-rojos')"
                        aria-label="Ver foto de Gin de frutos rojos">
                    📷
                </button>

            </article>


            <!-- CARRAJILLO BAILEYS -->
            <article class="bebida">

                <div class="informacion">

                    <div class="nombre-precio">
                        <h3>Carajillo Baileys</h3>
                        <span>Consultar</span>
                    </div>

                    <p>
                        Café espresso combinado con Baileys.
                    </p>

                </div>

                <button class="boton-foto"
                        onclick="abrirFoto('carajillo-baileys')"
                        aria-label="Ver foto de Carajillo Baileys">
                    📷
                </button>

            </article>


            <!-- COQUETA -->
            <article class="bebida">

                <div class="informacion">

                    <div class="nombre-precio">
                        <h3>Coqueta</h3>
                        <span>Consultar</span>
                    </div>

                    <p>
                        Cóctel de la casa.
                    </p>

                </div>

                <button class="boton-foto"
                        onclick="abrirFoto('coqueta')"
                        aria-label="Ver foto de Coqueta">
                    📷
                </button>

            </article>


            <!-- LYCHEE MARTINI -->
            <article class="bebida">

                <div class="informacion">

                    <div class="nombre-precio">
                        <h3>Lychee Martini</h3>
                        <span>Consultar</span>
                    </div>

                    <p>
                        Martini de lychee, delicado y refrescante.
                    </p>

                </div>

                <button class="boton-foto"
                        onclick="abrirFoto('lychee-martini')"
                        aria-label="Ver foto de Lychee Martini">
                    📷
                </button>

            </article>

        </section>

    </main>


    <!-- VENTANA DE LA FOTOGRAFÍA -->
    <div id="visor" class="visor">

        <button class="cerrar"
                onclick="cerrarFoto()"
                aria-label="Cerrar">
            ×
        </button>

        <div class="contenido-foto">

            <img id="imagenBebida" src="" alt="Fotografía de bebida">

            <h2 id="nombreBebida"></h2>

        </div>

    </div>


    <!-- PIE -->
    <footer>
        <p>Murmullos</p>
        <span>Menú de bebidas</span>
    </footer>


    <script src="funciones.js"></script>

</body>
</html>
