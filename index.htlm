  ```css
/* ==============================
   CONFIGURACIÓN GENERAL
================================ */

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    background: #3b2a20;
    color: #f7f2e9;
    font-family: "Montserrat", sans-serif;
    min-height: 100vh;
}


/* ==============================
   ENCABEZADO
================================ */

.encabezado {
    text-align: center;
    padding: 45px 20px 25px;
}

.luna {
    color: #c7a45b;
    font-size: 42px;
    line-height: 1;
    margin-bottom: 5px;
}

.encabezado h1 {
    color: #c7a45b;
    font-family: "Cormorant Garamond", serif;
    font-style: italic;
    font-size: 58px;
    font-weight: 500;
    letter-spacing: 1px;
}

.subtitulo {
    margin-top: 4px;
    font-size: 11px;
    letter-spacing: 4px;
    color: #eee7dc;
}

.linea {
    width: 75px;
    height: 1px;
    background: #c7a45b;
    margin: 20px auto 0;
}


/* ==============================
   MENÚ
================================ */

.menu {
    width: 100%;
    max-width: 700px;
    margin: auto;
    padding: 10px 22px 50px;
}

.categoria h2 {
    text-align: center;
    color: #c7a45b;
    font-family: "Cormorant Garamond", serif;
    font-style: italic;
    font-size: 34px;
    font-weight: 500;
    margin-bottom: 15px;
}


/* ==============================
   BEBIDAS
================================ */

.bebida {
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 18px 5px;

    border-bottom: 1px solid rgba(247, 242, 233, 0.2);
}

.informacion {
    padding-right: 15px;
    flex: 1;
}

.nombre-precio {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
}

.nombre-precio h3 {
    color: #fffaf2;
    font-family: "Cormorant Garamond", serif;
    font-size: 25px;
    font-weight: 600;
}

.nombre-precio span {
    color: #c7a45b;
    font-size: 12px;
    white-space: nowrap;
}

.informacion p {
    color: #d9d1c5;
    font-size: 12px;
    line-height: 1.5;
    margin-top: 5px;
}


/* ==============================
   BOTÓN DE CÁMARA
================================ */

.boton-foto {
    width: 42px;
    height: 42px;

    border: 1px solid #c7a45b;
    border-radius: 50%;

    background: transparent;
    color: #c7a45b;

    font-size: 18px;

    cursor: pointer;

    transition: 0.25s ease;
}

.boton-foto:hover {
    background: #c7a45b;
    color: #3b2a20;
    transform: scale(1.08);
}

.boton-foto:active {
    transform: scale(0.95);
}


/* ==============================
   VISOR DE FOTOGRAFÍA
================================ */

.visor {
    display: none;

    position: fixed;
    z-index: 1000;

    inset: 0;

    background: rgba(20, 13, 9, 0.94);

    justify-content: center;
    align-items: center;

    padding: 25px;
}

.visor.activo {
    display: flex;
}

.contenido-foto {
    width: 100%;
    max-width: 500px;

    text-align: center;

    animation: aparecer 0.25s ease;
}

.contenido-foto img {
    display: block;

    width: 100%;
    max-height: 70vh;

    object-fit: contain;

    border-radius: 8px;
}

.contenido-foto h2 {
    margin-top: 15px;

    color: #c7a45b;

    font-family: "Cormorant Garamond", serif;
    font-style: italic;

    font-size: 32px;
}


/* ==============================
   BOTÓN CERRAR
================================ */

.cerrar {
    position: absolute;

    top: 20px;
    right: 25px;

    background: transparent;
    border: none;

    color: #fff;

    font-size: 42px;
    font-weight: 300;

    cursor: pointer;

    line-height: 1;
}

.cerrar:hover {
    color: #c7a45b;
}


/* ==============================
   PIE
================================ */

footer {
    text-align: center;

    padding: 25px;

    border-top: 1px solid rgba(247, 242, 233, 0.15);

    color: #cfc5b8;
}

footer p {
    color: #c7a45b;

    font-family: "Cormorant Garamond", serif;
    font-style: italic;

    font-size: 25px;
}

footer span {
    font-size: 9px;
    letter-spacing: 3px;
}


/* ==============================
   ANIMACIÓN
================================ */

@keyframes aparecer {

    from {
        opacity: 0;
        transform: scale(0.94);
    }

    to {
        opacity: 1;
        transform: scale(1);
    }

}


/* ==============================
   CELULARES
================================ */

@media (max-width: 480px) {

    .encabezado {
        padding-top: 35px;
    }

    .encabezado h1 {
        font-size: 50px;
    }

    .menu {
        padding-left: 18px;
        padding-right: 18px;
    }

    .nombre-precio h3 {
        font-size: 23px;
    }

    .informacion p {
        font-size: 11px;
    }

}
```
```javascript
/* =====================================
   FOTOGRAFÍAS DE LAS BEBIDAS
===================================== */

const bebidas = {

    "mezcalitas": {
        nombre: "Mezcalitas",
        imagen: "imagenes/mezcalitas.png"
    },

    "gin-frutos-rojos": {
        nombre: "Gin de frutos rojos",
        imagen: "imagenes/gin-frutos-rojos.png"
    },

    "carajillo-baileys": {
        nombre: "Carajillo Baileys",
        imagen: "imagenes/carajillo-baileys.png"
    },

    "coqueta": {
        nombre: "Coqueta",
        imagen: "imagenes/coqueta.png"
    },

    "lychee-martini": {
        nombre: "Lychee Martini",
        imagen: "imagenes/lychee-martini.png"
    }

};


/* =====================================
   ABRIR FOTOGRAFÍA
===================================== */

function abrirFoto(id) {

    const bebida = bebidas[id];

    if (!bebida) {
        return;
    }

    const visor = document.getElementById("visor");
    const imagen = document.getElementById("imagenBebida");
    const nombre = document.getElementById("nombreBebida");

    imagen.src = bebida.imagen;
    imagen.alt = bebida.nombre;

    nombre.textContent = bebida.nombre;

    visor.classList.add("activo");

    document.body.style.overflow = "hidden";
}


/* =====================================
   CERRAR FOTOGRAFÍA
===================================== */

function cerrarFoto() {

    const visor = document.getElementById("visor");

    visor.classList.remove("activo");

    document.body.style.overflow = "";

}


/* =====================================
   CERRAR TOCANDO FUERA DE LA FOTO
===================================== */

document.getElementById("visor").addEventListener("click", function(event) {

    if (event.target === this) {
        cerrarFoto();
    }

});


/* =====================================
   CERRAR CON LA TECLA ESC
===================================== */

document.addEventListener("keydown", function(event) {

    if (event.key === "Escape") {
        cerrarFoto();
    }

});
```

